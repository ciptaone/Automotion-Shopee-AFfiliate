# =============================================================================
# Shopee Affiliate Autopilot — PRODUCTION Environment Template (Part 9 §3)
#
# Copy to `.env.production` (or, recommended: a root-owned 0600 file referenced
# by the systemd `EnvironmentFile=` line in deploy/systemd/) and fill in REAL
# values. NEVER commit a filled-in copy: `.env*` is git-ignored except this
# placeholder template.
#
# Validation happens at startup (fail closed, key NAMES only, never values):
#   * NODE_ENV=production requires: DATABASE_URL, PUBLIC_URL (https://),
#     the complete S3 credential set, a non-placeholder AUTH_JWT_SECRET,
#     and an explicit (non-wildcard) CORS_ORIGINS.
#   * Missing/invalid keys  => process exits 78 (EX_CONFIG) before serving.
#   * PostgreSQL unreachable or schema not migrated => same, exit 78.
#   * File/in-memory persistence and silent mock fallbacks are impossible.
#
# Release sequence (see docs/implementation/part-09-deployment-runbook.md):
#   1. npm ci && npm run build
#   2. npm run db:migrate          <- explicit single-run migration step
#   3. npm run db:verify           <- schema diff must be clean (exit 0)
#   4. start the service           <- systemd/Start service
#   5. curl -fsS https://host/ready <- 200 only when DB+schema are ready
#   6. npm run preflight           <- BEFORE enabling automation (enables nothing)
#
# Migration NEVER runs implicitly at boot. Never run two migrate steps at once
# (the advisory lock serializes them anyway), never run `db:migrate` against a
# database you have not backed up, and never drop/reset production tables.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
# Listener behind the reverse proxy. Keep 127.0.0.1 when a local proxy fronts
# the app (recommended): the public interface is then proxy-only.
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
LOG_PRETTY=false

# --- Public origin (HTTPS terminates at the reverse proxy) -------------------
# REQUIRED. The https:// origin operators and the APK point at.
PUBLIC_URL=https://autopilot.example.com

# --- Auth boundary (APK <-> backend) -----------------------------------------
# REQUIRED, must NOT be a CHANGE_ME placeholder. Generate per deployment and
# store ONLY in the server environment (root-owned file / secret manager):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=CHANGE_ME_random_48_byte_secret_per_deployment
AUTH_JWT_ISSUER=shopee-affiliate-autopilot
AUTH_JWT_AUDIENCE=autopilot-apk
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# The ONLY value provisioned onto a phone (exchanged via POST /v1/auth/token).
APP_INSTALL_KEY=CHANGE_ME_unique_install_key_per_deployment

# --- CORS --------------------------------------------------------------------
# REQUIRED, explicit allow-list, "*" is rejected in production. Include the
# PUBLIC_URL origin if any browser tooling calls the API.
CORS_ORIGINS=https://autopilot.example.com

# --- PostgreSQL (REQUIRED in production) -------------------------------------
# Bind PostgreSQL to localhost/private network only; never expose 5432 publicly.
# TLS: append ?sslmode=verify-full (with the server CA on the host) when the
# database is remote; sslmode=require for providers that terminate TLS.
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/autopilot
# Bounded pool (max must be >= min; keep headroom for manual psql sessions).
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=5
# Pins the backend to PostgreSQL explicitly (production derives it anyway).
PERSISTENCE_BACKEND=postgres

# --- Lifecycle (Part 9 §5) ---------------------------------------------------
# Bounded grace for in-flight scheduler/job work on SIGTERM. systemd's
# TimeoutStopSec in deploy/ is this value + 15 s hard deadline + margin.
SHUTDOWN_GRACE_MS=20000
# Job-lease window: a crashed worker's jobs are requeued after this.
JOB_LEASE_SECONDS=120

# --- Scheduler ---------------------------------------------------------------
# One scheduler is safe: ticks are serialized by a PostgreSQL advisory lock,
# claims by leases, daily output by a transactional cap. To split processes,
# set SCHEDULER_ENABLED=false on API replicas and true on the worker.
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Jakarta
SCHEDULER_INTERVAL_MINUTES=60
SCHEDULER_MAX_SLOTS_PER_DAY=24
SCHEDULER_MODE=mock
# 3-4 posts per WIB day (4 = default; operator-adjustable at runtime too).
SCHEDULER_DAILY_POST_TARGET=4

# --- AI providers (text and image kept SEPARATE) -----------------------------
# Production guidance: select + test real providers (workspace settings or
# these defaults) BEFORE enabling automation. A production boot with mock
# generation defaults is loud (warning + persistent ops event) but allowed so
# deployments without keys can still boot the API with automation paused.
AI_IMAGE_PROVIDER=mock
AI_IMAGE_MODEL=mock-image-v1
# AI_IMAGE_API_KEY=
AI_TEXT_PROVIDER=mock
AI_TEXT_MODEL=mock-text-v1
# AI_TEXT_API_KEY=

# --- S3-compatible object storage (REQUIRED in production) -------------------
# Durable assets must outlive the process: production refuses to start with
# only the in-memory mock. Works with AWS S3 / R2 / Spaces / MinIO / B2.
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=autopilot-assets
S3_ACCESS_KEY_ID=CHANGE_ME_s3_access_key_id
S3_SECRET_ACCESS_KEY=CHANGE_ME_s3_secret_access_key
S3_FORCE_PATH_STYLE=false
# Public URL Facebook/Threads cURL to fetch generated images (CDN/bucket URL).
S3_PUBLIC_BASE_URL=https://cdn.example.com
# Optional ACL for stores that support it; unset = bucket policy (default).
# S3_OBJECT_ACL=public-read

# --- Server-side secret encryption (provider credentials) --------------------
# REQUIRED to store live provider credentials (AES-256-GCM, 32 bytes).
# Back this key up SEPARATELY from database backups — without it, encrypted
# provider secrets in a restored database stay unreadable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=CHANGE_ME_32_byte_base64_key

# --- Telegram notifications (optional; both or neither) ----------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Shopee feed -------------------------------------------------------------
# Upload mode only; live feed ingestion stays BLOCKED (no official contract).
SHOPEE_FEED_MODE=upload
# SHOPEE_AFFILIATE_API_BASE=
# SHOPEE_AFFILIATE_API_TOKEN=
# SHOPEE_APP_ID=
# SHOPEE_APP_SECRET=

# --- Facebook / Threads publishing -------------------------------------------
# LIVE PUBLISHING IS DISABLED BY DEFAULT AND NOT ENABLED BY THIS FILE.
# The publisher allow-live latch stays off unless live publishing is
# explicitly authorized in a later, reviewed change.
FACEBOOK_GRAPH_API_BASE=https://graph.facebook.com
FACEBOOK_GRAPH_API_VERSION=v23.0
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
THREADS_API_BASE=https://graph.threads.net
THREADS_API_VERSION=v1.0
# THREADS_USER_ID=
# THREADS_ACCESS_TOKEN=
# THREADS_APP_ID=
# THREADS_APP_SECRET=

# --- Self-hosted provider endpoints (optional) -------------------------------
# Comma-separated hostnames allowed to sit on private ranges (never
# client-controlled input; SSRF policy stays in force for everything else).
# SELF_HOSTED_ENDPOINT_ALLOWLIST=
