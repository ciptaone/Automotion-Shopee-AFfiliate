# --- OS / Editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Node / Backend ---
node_modules/
backend/dist/
build/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# --- Secrets & local env ---
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
secrets/
# Source code for the secret STORE (AES-GCM); it contains no credentials.
!backend/src/secrets/
credentials.json
service-account*.json

# --- Drizzle / local db dumps ---
# Drizzle snapshots MUST be committed: `drizzle-kit generate` diffs the live
# schema against the snapshot of the last journal entry, so without it a fresh
# clone would silently re-generate migrations that already exist (PART 5).
# backend/drizzle/meta/*_snapshot.json
*.sql.gz
dump*.sql

# --- Flutter / Dart ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
.pub-cache/
.pub/
coverage/
*.iml
ios/Pods/
android/.gradle/
android/local.properties
android/key.properties
*.jks
*.keystore
*.ipa
*.apk
!docs/**/*.apk

# --- Logs & runtime ---
*.log
logs/
tmp/
temp/
.runtime/

# --- Backend runtime state (settings persistence; never commit) ---
backend/data/
data/

# --- Test artifacts ---
.vitest-cache/
test-results/
evidence/**/*.tmp
