# =============================================================================
# Shopee Affiliate Autopilot — Backend Environment
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# MUST NEVER be committed.
#
# RULES:
#   * Every value below is a PLACEHOLDER. No real secrets ship with this repo.
#   * Part 1 runs fully credential-free using deterministic mocks. Only
#     NODE_ENV, PORT, AUTH_JWT_SECRET and CORS_ORIGINS are required to boot.
#   * The Flutter APK must NEVER contain any of these values except the
#     operator-issued APP_INSTALL_KEY (see AUTH section).
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Set true for human-readable logs in local development only.
LOG_PRETTY=false

# --- APK <-> backend auth boundary -------------------------------------------
# REQUIRED. HS256 signing secret for APK session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 characters. Treat like a password.
AUTH_JWT_SECRET=CHANGE_ME_min_32_chars_random_secret_value
AUTH_JWT_ISSUER=shopee-affiliate-autopilot
AUTH_JWT_AUDIENCE=autopilot-apk
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600

# Shared install key the APK exchanges for a JWT via POST /v1/auth/token.
# This is the ONLY value that may be provisioned onto the user's phone.
APP_INSTALL_KEY=CHANGE_ME_shared_install_key_delivered_to_apk

# --- CORS --------------------------------------------------------------------
# Comma-separated explicit allow-list. Wildcard "*" is rejected in production.
# For a Flutter APK talking directly to the backend, allow the backend origin
# itself; the APK uses a native HTTP client, not browser CORS.
CORS_ORIGINS=http://localhost:8080

# --- Database (optional in Part 1) -------------------------------------------
# When unset, the backend runs fully in-memory (job queue + storage are mocks).
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/autopilot

# --- Scheduler ---------------------------------------------------------------
# Part 1 ships the slot ENGINE only; dispatch is disabled until the automation
# part lands. SCHEDULER_MODE=mock ticks the scheduler without credentials.
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Jakarta
SCHEDULER_INTERVAL_MINUTES=60
SCHEDULER_MAX_SLOTS_PER_DAY=24
SCHEDULER_MODE=mock

# --- Shopee Affiliate Product Feed -------------------------------------------
# Part 1 supports USER-PROVIDED CSV/XLSX uploads only. No live API is assumed.
# See docs/implementation/part-01-integration-feasibility.md (status: BLOCKED).
SHOPEE_FEED_MODE=upload
# SHOPEE_AFFILIATE_API_BASE=
# SHOPEE_AFFILIATE_API_TOKEN=
# SHOPEE_APP_ID=
# SHOPEE_APP_SECRET=

# --- Facebook Page publishing -----------------------------------------------
# Publisher stays DISABLED until both values are set AND live publishing is
# explicitly authorized. Part 1 never performs live Graph API calls.
FACEBOOK_GRAPH_API_BASE=https://graph.facebook.com
FACEBOOK_GRAPH_API_VERSION=v23.0
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=

# --- Threads publishing ------------------------------------------------------
# Threads requires a Meta app created with the "Threads use case".
THREADS_API_BASE=https://graph.threads.net
THREADS_API_VERSION=v1.0
# THREADS_USER_ID=
# THREADS_ACCESS_TOKEN=
# THREADS_APP_ID=
# THREADS_APP_SECRET=

# --- Telegram notifications --------------------------------------------------
# Create a bot via @BotFather to obtain the token; chat id from getUpdates.
# Part 1 uses an in-memory transport; no real messages are sent by tests.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- S3-compatible object storage --------------------------------------------
# Works with AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO, Backblaze B2.
# Part 1 uses an in-memory mock even when these are set.
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# Public base URL Facebook/Threads will cURL to fetch the generated image.
# S3_PUBLIC_BASE_URL=

# --- AI providers (provider-agnostic) ----------------------------------------
# 'mock' (default) is deterministic and free. Switch to 'openai'/'google' only
# after the evaluation in the feasibility report, and always set the key.
AI_IMAGE_PROVIDER=mock
AI_IMAGE_MODEL=mock-image-v1
# AI_IMAGE_API_KEY=
AI_TEXT_PROVIDER=mock
AI_TEXT_MODEL=mock-text-v1
# AI_TEXT_API_KEY=
